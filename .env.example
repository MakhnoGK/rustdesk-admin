# Copy to .env and fill in the secrets: `cp .env.example .env`.
# docker compose reads this file; `pnpm dev` (apps/api) reads it too.
# Generate secrets with:  openssl rand -base64 48   (JWT)   /   openssl rand -base64 32   (AB key)

# ---- Runtime ---------------------------------------------------------------------------------
# development | production | test
NODE_ENV=production
# RustDesk clients derive the API URL from the ID server on port 21114 when "API server" is empty.
PORT=21114
# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- Database --------------------------------------------------------------------------------
# docker compose builds DATABASE_URL from POSTGRES_* below; set it yourself for local development.
POSTGRES_USER=rustdesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rustdesk
# Local development (pnpm dev against `docker compose up -d db`):
DATABASE_URL=postgresql://rustdesk:change-me@localhost:5432/rustdesk

# ---- RustDesk client tokens ------------------------------------------------------------------
# Signing secret for tokens issued by POST /api/login (>= 32 chars, different from ADMIN_JWT_SECRET).
RUSTDESK_JWT_SECRET=
# The client cannot refresh tokens: users log in again after this many days. Revocable by admins.
RUSTDESK_TOKEN_TTL_DAYS=30

# ---- Admin panel -----------------------------------------------------------------------------
# Signing secret for admin session cookies (>= 32 chars).
ADMIN_JWT_SECRET=
ADMIN_SESSION_TTL_HOURS=12
# Public URL(s) of the admin panel. State-changing admin requests must carry one of these as Origin.
ADMIN_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Keep true. false only for plain-HTTP setups outside localhost (a warning is logged).
ADMIN_COOKIE_SECURE=true
# First administrator, created by the seed only when no administrator exists (password >= 12 chars).
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# ---- Address books ---------------------------------------------------------------------------
# AES-256-GCM key for stored peer hashes/passwords: 32 bytes, base64.
AB_SECRET_KEY=
# ID written into every ciphertext; change it when you rotate AB_SECRET_KEY.
AB_SECRET_KEY_ID=k1
# Retired keys that can still decrypt during rotation: "<keyId>:<base64key>,..."
AB_PREVIOUS_SECRET_KEYS=
# max_peer_one_ab reported to clients and enforced by the server; 0 = unlimited.
AB_MAX_PEERS=0

# ---- Sessions --------------------------------------------------------------------------------
# An active session with no liveness evidence for this long becomes TIMEOUT.
SESSION_TIMEOUT_MINUTES=120
SESSION_TIMEOUT_CHECK_INTERVAL_SECONDS=60
# A session missing from a heartbeat's `conns` is closed only once it is older than this.
HEARTBEAT_GRACE_SECONDS=30
# A device is online when its last heartbeat is newer than this.
DEVICE_ONLINE_THRESHOLD_SECONDS=45
# An undelivered remote-disconnect request expires after this.
DISCONNECT_TTL_SECONDS=120
# Delete audit events older than this many days (hourly job, in batches). 0 = keep forever.
AUDIT_RETENTION_DAYS=0
# Maximum range of /api/admin/stats queries.
STATS_MAX_RANGE_DAYS=366
# Background jobs (timeout sweep, retention). Safe on several instances (advisory locks).
JOBS_ENABLED=true

# ---- Network ---------------------------------------------------------------------------------
# Optional allowlist for the unauthenticated device endpoints (/api/audit/*, /api/heartbeat,
# /api/sysinfo*): comma-separated CIDRs or addresses. Empty = allow all.
DEVICE_ALLOWED_CIDRS=
# Reverse proxies whose X-Forwarded-For is trusted (addresses/CIDRs, or "loopback", "uniquelocal").
# Empty = trust none: the socket address is the client address.
TRUSTED_PROXIES=

# ---- Rate limits (per minute, in memory per instance) -----------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_USERNAME_PER_MINUTE=5
RATE_LIMIT_DEVICE_PER_MINUTE=120
RATE_LIMIT_DEVICE_IP_PER_MINUTE=6000
RATE_LIMIT_API_PER_MINUTE=600

# ---- OpenAPI ---------------------------------------------------------------------------------
# Swagger UI at /api/docs. Always on outside production; in production only when true.
SWAGGER_ENABLED=false
