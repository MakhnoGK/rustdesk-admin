# Build-time configuration (Vite). Everything here ends up in the public bundle: no secrets.
# Runtime values from /config.js (Docker: APP_NAME, ACTIVE_SESSIONS_REFRESH_MS) override these.

# Empty = same origin (nginx or the Vite dev proxy forwards /api). API paths already start with /api.
VITE_API_BASE_URL=
VITE_ACTIVE_SESSIONS_REFRESH_MS=5000
VITE_APP_NAME=RustDesk Admin

# Development only
VITE_DEV_API_PROXY_TARGET=http://localhost:21114
