{
  "name": "rustdesk-admin",
  "private": true,
  "description": "Self-hosted RustDesk API server and admin panel (monorepo)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "openapi": "turbo run generate --filter=@rustdesk-admin/api-contract",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "turbo": "2.11.7"
  }
}
